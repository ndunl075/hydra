{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "types": ["node", "vscode"], "noEmit": true
  },
  "include": ["src", "webview", "tests"]
}
