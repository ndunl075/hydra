{
  "name": "hydra-agent-manager",
  "displayName": "Hydra",
  "icon": "hydra-logo.png",
  "description": "Hydra IDE's built-in Editor and Agents workflow with isolated Git worktrees and native provider terminals.",
  "version": "0.22.0",
  "publisher": "nico-dunlap",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndunl075/hydra.git"
  },
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.113.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "desktop:prepare": "node scripts/desktop.mjs prepare",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:verify": "node scripts/desktop.mjs verify",
    "desktop:smoke": "node scripts/desktop.mjs smoke",
    "desktop:installer": "node scripts/desktop.mjs installer",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:installed-inventory": "node --test tests/desktopInstalledInventory.test.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out hydra-core-0.21.0.vsix",
    "vscode:prepublish": "npm run check && npm run build",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "hydra.openQuotaStatus",
        "title": "Hydra: Provider Usage Limits"
      },
      {
        "command": "hydra.debug.simulateLimit",
        "title": "Hydra: Simulate a Usage Limit (debug)"
      },
      {
        "command": "hydra.openAccounts",
        "title": "Hydra: Provider Accounts"
      },
      {
        "command": "hydra.openOnboarding",
        "title": "Hydra: Open Onboarding"
      },
      {
        "command": "hydra.openSettings",
        "title": "Hydra: Open Settings"
      },
      {
        "command": "hydra.setChatLocation",
        "title": "Hydra: Set Chat Location"
      },
      {
        "command": "hydra.checkProvider",
        "title": "Hydra: Check Default Provider Capabilities"
      },
      {
        "command": "hydra.openOfficialExtension",
        "title": "Hydra: Open Official Extension in Handoff Workspace"
      },
      {
        "command": "hydra.toggleMode",
        "title": "Hydra: Toggle Editor / Agents",
        "icon": "$(layout)"
      },
      {
        "command": "hydra.openAgents",
        "title": "Hydra: Open Agents",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "hydra.newPlan",
        "title": "Hydra: New Plan",
        "icon": "$(checklist)"
      },
      {
        "command": "hydra.stopAllHelpers",
        "title": "Hydra: Stop All Heads"
      },
      {
        "command": "hydra.newLane",
        "title": "Hydra: New Lane",
        "icon": "$(add)"
      },
      {
        "command": "hydra.openLanes",
        "title": "Hydra: Open Lanes"
      },
      {
        "command": "hydra.openCanvas",
        "title": "Hydra: Open Agents Canvas"
      },
      {
        "command": "hydra.overview.mergeLane",
        "title": "Merge",
        "icon": "$(git-merge)"
      },
      {
        "command": "hydra.overview.closeLane",
        "title": "Close",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "hydra.debug.simulateLimit",
          "when": "false"
        },
        {
          "command": "hydra.overview.mergeLane",
          "when": "false"
        },
        {
          "command": "hydra.overview.closeLane",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "hydra.newLane",
          "when": "view == hydra.overview",
          "group": "navigation@1"
        },
        {
          "command": "hydra.newPlan",
          "when": "view == hydra.overview",
          "group": "navigation@2"
        },
        {
          "command": "hydra.openAgents",
          "when": "view == hydra.overview",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "hydra.overview.mergeLane",
          "when": "view == hydra.overview && viewItem =~ /^lane/",
          "group": "inline@1"
        },
        {
          "command": "hydra.overview.closeLane",
          "when": "view == hydra.overview && viewItem =~ /^lane/",
          "group": "inline@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hydra",
          "title": "Hydra",
          "icon": "hydra-logo.png"
        }
      ]
    },
    "views": {
      "hydra": [
        {
          "id": "hydra.overview",
          "name": "Overview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hydra.overview",
        "contents": "Run several agents at once.\n[New lane](command:hydra.newLane)\n[New plan](command:hydra.newPlan)\n[Open Agents view](command:hydra.openAgents)"
      }
    ],
    "keybindings": [
      {
        "command": "hydra.toggleMode",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "hydra.openSettings",
        "key": "ctrl+shift+,",
        "mac": "cmd+shift+,"
      }
    ],
    "themes": [
      {
        "label": "Hydra Dark",
        "uiTheme": "vs-dark",
        "path": "themes/hydra-dark.json"
      },
      {
        "label": "Hydra Light",
        "uiTheme": "vs",
        "path": "themes/hydra-light.json"
      }
    ],
    "configurationDefaults": {
      "workbench.activityBar.location": "top",
      "workbench.startupEditor": "none",
      "workbench.editor.tabHeight": "compact",
      "window.commandCenter": false,
      "workbench.layoutControl.type": "menu",
      "git.detectWorktrees": false
    },
    "configuration": {
      "title": "Hydra",
      "properties": {
        "hydra.handoff": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "scope": "window",
          "description": "Handoff descriptor in a generated Hydra handoff workspace. Do not edit manually."
        },
        "hydra.defaultProvider": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ],
          "default": "claude",
          "description": "Provider checked by \"Hydra: Check Default Provider Capabilities\"."
        },
        "hydra.claudePath": {
          "type": "string",
          "default": "",
          "description": "Absolute Claude CLI executable path. Empty searches PATH."
        },
        "hydra.codexPath": {
          "type": "string",
          "default": "",
          "description": "Absolute Codex CLI executable path. Empty searches PATH."
        },
        "hydra.worktreeRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute directory for Hydra head worktrees, outside the repository. Empty uses a sibling <repository>.worktrees folder."
        },
        "hydra.maxConcurrentHelpers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 3,
          "description": "Maximum Hydra heads running at once in this window. More wait in a queue."
        },
        "hydra.chatLocation": {
          "type": "string",
          "enum": [
            "docked",
            "tabs"
          ],
          "enumDescriptions": [
            "Docked: the Claude Code and Codex chats live in the side bar, locked in place.",
            "Tabs: chats open as editor tabs, one per conversation, like Cursor."
          ],
          "default": "docked",
          "markdownDescription": "Where the Claude Code and Codex chats open. Applies Claude's own `#claudeCode.preferredLocation#` setting and routes Hydra's open-chat actions to each provider's tab command in Tabs mode."
        },
        "hydra.startupLayout": {
          "type": "string",
          "enum": [
            "editor",
            "agents"
          ],
          "enumDescriptions": [
            "Editor: this window opens in the code editor.",
            "Agents: this window opens in the Agents view."
          ],
          "default": "editor",
          "description": "Which view a Hydra window opens in on startup."
        },
        "hydra.heads.defaultMinutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 480,
          "default": 30,
          "description": "Default time cap, in minutes, for a Hydra head started without its own limit."
        },
        "hydra.heads.defaultMaxTurns": {
          "type": "number",
          "minimum": 1,
          "maximum": 500,
          "default": 60,
          "description": "Default turn cap for a Hydra head started without its own limit."
        },
        "hydra.heads.defaultBudgetUsd": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 100,
          "default": 5,
          "description": "Default budget cap, in USD, for a Hydra head started without its own limit."
        },
        "hydra.limits.offerHandoff": {
          "type": "boolean",
          "default": true,
          "description": "When Claude Code or Codex hits its usage limit, offer to continue in the other provider with a handoff."
        },
        "hydra.lanes.onLimit": {
          "type": "string",
          "enum": ["ask", "switch"],
          "enumDescriptions": [
            "Show a banner on the lane's tile with Continue in the other provider, View handoff and Wait.",
            "Count down 10 seconds on the lane's tile (Cancel stops it), then switch to the other provider automatically."
          ],
          "default": "ask",
          "description": "When a lane's provider hits its usage limit, whether to ask before continuing in the other provider or switch automatically."
        }
      }
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsonc-parser": "3.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "resedit": "3.1.0",
    "typescript": "^5.7.0"
  }
}
