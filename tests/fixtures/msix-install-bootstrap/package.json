{
  "name": "hydra-msix-install-bootstrap",
  "displayName": "Hydra MSIX Install Bootstrap",
  "description": "Development-only bootstrap for the disposable MSIX extension-install acceptance gate.",
  "version": "1.0.0",
  "publisher": "hydra-msix-bootstrap",
  "private": true,
  "engines": {
    "vscode": "^1.113.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  }
}
