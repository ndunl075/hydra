{
  "$schema": "vscode://schemas/color-theme",
  "name": "Hydra Dark",
  "type": "dark",
  "colors": {
    "titleBar.inactiveBackground": "#141414", "activityBarTop.foreground": "#F0F0F0", "activityBarTop.inactiveForeground": "#F0F0F0BD",
    "foreground": "#F0F0F0",
    "editorGutter.addedBackground": "#3FA266", "editorGutter.deletedBackground": "#E34671", "editorGutter.modifiedBackground": "#D2943E",
    "gitDecoration.addedResourceForeground": "#70B489", "gitDecoration.deletedResourceForeground": "#FC6B83", "gitDecoration.ignoredResourceForeground": "#F0F0F099",
    "gitDecoration.modifiedResourceForeground": "#F1B467", "gitDecoration.untrackedResourceForeground": "#88C0D0", "list.deemphasizedForeground": "#F0F0F0BD",
    "list.dropBackground": "#F0F0F011", "list.errorForeground": "#FC6B83", "list.focusBackground": "#F0F0F01E",
    "list.focusForeground": "#F0F0F0", "list.highlightForeground": "#88C0D0", "list.hoverForeground": "#F0F0F0",
    "list.inactiveSelectionForeground": "#F0F0F0", "list.invalidItemForeground": "#F0F0F099", "list.warningForeground": "#F1B467",
    "tree.inactiveIndentGuidesStroke": "#F0F0F013",
    "editor.background": "#141414", "editor.foreground": "#F5F5F5",
    "sideBar.background": "#141414", "sideBar.foreground": "#F0F0F0BD",
    "sideBarSectionHeader.background": "#141414", "sideBarSectionHeader.foreground": "#F0F0F05C", "sideBarTitle.foreground": "#F0F0F0BD",
    "activityBar.background": "#141414", "activityBar.foreground": "#F5F5F5",
    "activityBarBadge.background": "#173C2C", "activityBarBadge.foreground": "#FFFFFF",
    "titleBar.activeBackground": "#141414", "titleBar.activeForeground": "#B8B8B8", "titleBar.inactiveForeground": "#7A7A7A",
    "statusBar.background": "#141414", "statusBar.foreground": "#C8C8C8",
    "statusBar.noFolderBackground": "#141414", "statusBar.debuggingBackground": "#173C2C",
    "tab.activeBackground": "#141414", "tab.inactiveBackground": "#111111", "tab.activeForeground": "#F5F5F5",
    "editorGroupHeader.tabsBackground": "#111111", "panel.background": "#141414",
    "terminal.background": "#141414", "terminal.foreground": "#F5F5F5",
    "button.background": "#173C2C", "button.foreground": "#FFFFFF", "button.hoverBackground": "#24553F",
    "focusBorder": "#F0F0F026", "list.activeSelectionBackground": "#F0F0F01E",
    "list.activeSelectionForeground": "#F0F0F0", "list.hoverBackground": "#F0F0F011",
    "list.inactiveSelectionBackground": "#F0F0F011", "list.focusOutline": "#F0F0F026", "tree.indentGuidesStroke": "#F0F0F030",
    "input.background": "#1B1B1B", "input.foreground": "#F5F5F5", "input.border": "#363636",
    "editor.selectionBackground": "#294B3A", "editor.lineHighlightBackground": "#1C1C1C",
    "editorLineNumber.foreground": "#717171", "editorLineNumber.activeForeground": "#C8C8C8",
    "panel.border": "#2B2B2B", "sideBar.border": "#F0F0F013",
    "textLink.foreground": "#9FCAB0", "textLink.activeForeground": "#C0E4CD"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#818A83" } },
    { "scope": ["string"], "settings": { "foreground": "#AED1BA" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#DFD4C0" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#D7E2DB" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#D8BFA1" } }
  ]
}
